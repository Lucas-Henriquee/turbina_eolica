FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    propeller
    {
        type triSurfaceMesh;
        file "propeller_new.stl";
    }

    cylinder
    {
        type triSurfaceMesh;
        file "cylinder.stl";
    }
}

castellatedMeshControls
{
    maxLocalCells       5000000;
    maxGlobalCells      20000000;
    minRefinementCells  10;
    nCellsBetweenLevels 3;

    locationInMesh (0.0 -1.0 0.0);

    features
    (
        {
            file "propeller_new.eMesh";
            level 6;
        }
        {
            file "cylinder.eMesh";
            level 1;
        }
    );

    refinementSurfaces
    {
        propeller
        {
            level (4 5);
            patchInfo
            {
                type wall;
            }
        }

        cylinder
        {
            level (1 1);

            faceZone    cylinder;
            cellZone    cylinder;
            cellZoneInside inside;

            patchInfo
            {
                type wall;
            }
        }
    }

    refinementRegions
    {
        propeller
        {
            mode distance;
            levels
            (
                (0.005  4)
                (0.015  3)
                (0.030  2)
            );
        }

        cylinder
        {
            mode inside;
            levels ((1E15 1));
        }
    }

    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           0.7;
    nSolveIter          30;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;

    layers
    {
        propeller
        {
            nSurfaceLayers 3;
        }
    }

    expansionRatio       1.2;
    finalLayerThickness  0.3;
    minThickness         0.1;
    nGrow                0;
    featureAngle         60;
    nRelaxIter           3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals       3;
    nSmoothThickness     10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle   90;
    nBufferCellsNoExtrude 0;
    nLayerIter           50;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-6;