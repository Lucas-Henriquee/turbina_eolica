FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}

// Região interna móvel; domínio externo permanece estacionário
dynamicFvMesh   dynamicMultiMotionSolverFvMesh;

dynamicMultiMotionSolverFvMeshCoeffs
{
    rotor
    {
        // Região da malha que efetivamente será movimentada
        cellZone cylinder;

        solver sixDoFRigidBodyMotion;

        sixDoFRigidBodyMotionCoeffs
        {
            // Superfície usada para calcular forças e momentos
            patches (propeller);

            // Todo o cylinder deve se comportar praticamente
            // como uma região rígida
            innerDistance 0.40;
            outerDistance 0.50;

            // Propriedades calculadas para propeller_new.stl
            // assumindo PLA sólido com rho = 1240 kg/m3
            centreOfMass
            (
                0
                0.001462
                0
            );

            mass 0.883075;

            momentOfInertia
            (
                0.000570001
                0.010429824
                0.010440584
            );

            // Caso incompressível
            rho     rhoInf;
            rhoInf  1.225;

            // Sem gravidade neste primeiro teste
            g (0 0 0);

            report on;

            // Sub-relaxacao do acoplamento fluido-corpo para maior robustez numerica.
            // 1.0 = sem sub-relaxacao; 0.7 suaviza a atualizacao da aceleracao.
            accelerationRelaxation 0.7;
            accelerationDamping    1.0;

            // Integração do movimento
            solver
            {
                type  Newmark;
                gamma 0.5;
                beta  0.25;
            }

            constraints
            {
                // Impede qualquer translação do eixo
                fixedCentre
                {
                    sixDoFRigidBodyMotionConstraint point;
                    centreOfRotation (0 0 0);
                }

                // Permite rotação exclusivamente em Y
                rotationY
                {
                    sixDoFRigidBodyMotionConstraint axis;
                    axis (0 1 0);
                }
            }

            restraints
            {
                // Atrito viscoso equivalente no eixo:
                // M_d = -c * omega
                // Unidade de c: N.m.s/rad
                // VALOR PROVISORIO: deve ser calibrado quando houver dados
                // experimentais do eixo/rolamentos. Em omega=30 rad/s,
                // c=1e-4 produz aproximadamente 0.003 N.m de torque resistente.
                shaftViscousDamping
                {
                    sixDoFRigidBodyMotionRestraint sphericalAngularDamper;
                    coeff 1.0e-4;
                }
            }

        }
    }
}

