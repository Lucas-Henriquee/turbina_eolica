# OpenFOAM parallel decomposition
*/processor*/

# Time directories generated by solver (keep 0 and 0.orig)
*/[1-9]*/
*/[1-9]*.[0-9]*/

# Post-processing outputs
*/postProcessing/
*/VTK/

# Generated mesh and topology
*/constant/polyMesh/

# Generated feature meshes (regenerate with surfaceFeatureExtract)
*/constant/triSurface/*.eMesh

# Generated blade/hub geometry
*/helice.stl
*/hub.stl
*/constant/triSurface/helice.stl
*/constant/triSurface/hub.stl

# Logs and crash files
log.*
*.log
core
core.*

# OpenFOAM case shortcuts and local/editor files
*.foam
*.OpenFOAM

.history/