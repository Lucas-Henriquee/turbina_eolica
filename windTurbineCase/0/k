        type            fixedValue;
        value           uniform 0.02;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.02;
        value           uniform 0.02;
    }
    sides
    {
        type            kqRWallFunction;
        value           uniform 0.02;
    }
    propeller
    {
        type            kqRWallFunction;
        value           uniform 0.02;
    }
    AMI1
    {
        type            cyclicAMI;
        value           uniform 0;
    }
    AMI2
    {
        type            cyclicAMI;
        value           uniform 0;
    }
}