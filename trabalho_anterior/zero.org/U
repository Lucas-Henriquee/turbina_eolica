FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// AJUSTE 1: Inicializa o campo já com a velocidade do vento (ajuda na convergência)
internalField   uniform (0 3.3 0); 

boundaryField
{
    //- Set patchGroups for constraint patches
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        // AJUSTE 2: Velocidade reduzida para 3.3 m/s (Eixo Y) para atingir TSR ~7
        value           uniform (0 3.3 0); 
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    wall
    {
        type            noSlip;
    }

    helice
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    AMI1
    {
        type            cyclicAMI;
    }

    AMI2
    {
        type            cyclicAMI;
    }
}

