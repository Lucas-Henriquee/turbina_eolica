// Define que o movimento é PRESCRITO (Solid Body)
dynamicFvMesh   dynamicMotionSolverFvMesh;

motionSolverLibs ( "libfvMotionSolvers.so" );

solver          solidBody;

solidBodyCoeffs
{
    cellZone        cylinder;   // <--- MUDANÇA AQUI (o nome que está na sua malha)

    solidBodyMotionFunction  rotatingMotion;
    rotatingMotionCoeffs
    {
        origin      (0 0 0);
        axis        (0 1 0);
        omega 106.0;
    }
}