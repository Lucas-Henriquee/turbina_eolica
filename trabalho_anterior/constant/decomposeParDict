FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


numberOfSubdomains 2;

method          hierarchical;

hierarchicalCoeffs
{
    n               (3 3 2); // produto tem que ser 18
    delta           0.001;
    order           xyz;
}
