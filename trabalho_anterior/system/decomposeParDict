FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 6; // Ajustado para o Ryzen 5 5600G (6 núcleos físicos)

method simple; // Melhor método para dividir automaticamente

simpleCoeffs
{
    n (6 1 1);
}

