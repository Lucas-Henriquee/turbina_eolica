FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}

internalFacesOnly true;

// Divide a interface em dois patches AMI.
baffles
{
    rotatingInterface
    {
        type        faceZone;
        zoneName    cylinder;

        patches
        {
            master
            {
                name            AMI1;
                type            cyclicAMI;
                lowWeightCorrection {{ami_low_weight}};
                minCosAngle {{ami_min_cos_angle}};
                maxDistance2 {{ami_max_distance_squared}};
                neighbourPatch  AMI2;
            }

            slave
            {
                name            AMI2;
                type            cyclicAMI;
                lowWeightCorrection {{ami_low_weight}};
                minCosAngle {{ami_min_cos_angle}};
                maxDistance2 {{ami_max_distance_squared}};
                neighbourPatch  AMI1;
            }
        }
    }
}
