FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale 1;

// Limites do domínio.
vertices
(
    ({{xmin}} {{ymin}} {{zmin}})
    ({{xmax}} {{ymin}} {{zmin}})
    ({{xmax}} {{ymax}} {{zmin}})
    ({{xmin}} {{ymax}} {{zmin}})
    ({{xmin}} {{ymin}} {{zmax}})
    ({{xmax}} {{ymin}} {{zmax}})
    ({{xmax}} {{ymax}} {{zmax}})
    ({{xmin}} {{ymax}} {{zmax}})
);
// Divisões da malha-base.
blocks
(
    hex (0 1 2 3 4 5 6 7) {{mesh_cells}} simpleGrading (1 1 1)
);

edges ();

// Condições nas faces externas.
boundary
(
    inlet
    {
        type patch;
        faces ( (0 1 5 4) );
    }

    outlet
    {
        type patch;
        faces ( (3 7 6 2) );
    }

    ground
    {
        type wall;
        faces ((0 3 2 1));
    }

    sides
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (4 5 6 7)
        );
    }
);
