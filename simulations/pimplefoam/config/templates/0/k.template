FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{turbulence_k}};

boundaryField
{
    fanInlet
    {
        type fixedValue;
        value uniform {{turbulence_k}};
    }
    "(inlet|outlet|sides)"
    {
        type inletOutlet;
        inletValue uniform {{turbulence_k}};
        value uniform {{turbulence_k}};
    }
    ground
    {
        type kqRWallFunction;
        value uniform {{turbulence_k}};
    }
    propeller
    {
        type            kqRWallFunction;
        value           uniform {{turbulence_k}};
    }
    AMI1
    {
        type            cyclicAMI;
        value           uniform {{turbulence_k}};
    }
    AMI2
    {
        type            cyclicAMI;
        value           uniform {{turbulence_k}};
    }
}


