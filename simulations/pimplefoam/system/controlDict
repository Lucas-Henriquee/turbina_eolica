FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;

libs
(
    "libsixDoFRigidBodyMotion.so"
);

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;

deltaT          0.0002;

writeControl    runTime;
writeInterval   0.1;

purgeWrite      0;

adjustTimeStep  true;
maxCo           0.5;
maxDeltaT       0.0002;

writeFormat     binary;
writePrecision  10;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable false;

#include "forces"
