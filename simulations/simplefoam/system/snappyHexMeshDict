FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

// Superfícies e região da entrada.
geometry
{
    fanRefinement
    {
        type searchableCylinder;
        point1 (0 -1.01 0);
        point2 (0 -0.8 0);
        radius 0.2;
    }
    propeller
    {
        type triSurfaceMesh;
        file "propeller_test.stl";
    }

    cylinder
    {
        type triSurfaceMesh;
        file "cylinder.stl";
    }
}

// Refinamento volumétrico.
castellatedMeshControls
{
    maxLocalCells       1000000;
    maxGlobalCells      5000000;
    minRefinementCells  10;
    nCellsBetweenLevels 2;

    locationInMesh (0 -0.7 0);

    features
    (
        {
            file "propeller_test.eMesh";
            level 6;
        }
        {
            file "cylinder.eMesh";
            level 1;
        }
    );

    refinementSurfaces
    {
        propeller
        {
            level (6 6);
            patchInfo
            {
                type wall;
            }
        }

        cylinder
        {
            level (2 2);

            faceType    internal;
            faceZone    cylinder;
            cellZone    cylinder;
            cellZoneInside inside;

        }
    }

    refinementRegions
    {
    fanRefinement
        {
            mode inside;
            levels ((1E15 2));
        }
            propeller
        {
            mode distance;
            levels
            (
                (0.001 6)
                (0.003 5)
                (0.008 4)
            );
        }

        cylinder
        {
            mode inside;
            levels ((1E15 1));
        }
    }

    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;
}

// Ajuste ao STL.
snapControls
{
    nSmoothPatch        8;
    tolerance           0.7;
    nSolveIter          30;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

// Camadas próximas à parede.
addLayersControls
{
    relativeSizes false;

    layers
    {
        propeller
        {
            nSurfaceLayers 2;
        }
    }

    expansionRatio       1.25;
    finalLayerThickness  0.0004;
    minThickness         5e-05;
    nGrow                0;
    featureAngle         80;
    nRelaxIter           3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals       3;
    nSmoothThickness     10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle   90;
    nBufferCellsNoExtrude 2;
    nLayerIter           36;
}

// Limites de qualidade.
meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-06;
