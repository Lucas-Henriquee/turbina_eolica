FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    p
    {
        solver GAMG;
        smoother GaussSeidel;
        tolerance 1e-08;
        relTol 0.01;
    }
    pFinal
    {
        $p;
        relTol 0;
    }

    pcorr
    {
        solver GAMG;
        smoother GaussSeidel;
        tolerance 1e-06;
        relTol 0;
    }
    pcorrFinal
    {
        $pcorr;
        relTol 0;
    }

    U
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-08;
        relTol 0.01;
    }
    UFinal
    {
        $U;
        relTol 0;
    }

    k
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-08;
        relTol 0.01;
    }
    kFinal
    {
        $k;
        relTol 0;
    }

    omega
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-08;
        relTol 0.01;
    }
    omegaFinal
    {
        $omega;
        relTol 0;
    }
}

// Critérios de parada do SIMPLE.
SIMPLE
{
    nNonOrthogonalCorrectors 2;
    residualControl
    {
        p 1e-05;
        U 1e-06;
        k 1e-06;
        omega 1e-06;
    }
}

relaxationFactors
{
    fields { p 0.2; }
    equations
    {
        U 0.3;
        k 0.3;
        omega 0.3;
    }
}
