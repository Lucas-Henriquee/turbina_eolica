FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object MRFProperties;
}

// Velocidade angular prescrita; a malha permanece fixa.
MRF1
{
    active yes;
    cellZone cylinder;
    nonRotatingPatches ();
    origin {{rotation_centre}};
    axis (0 1 0);
    omega {{angular_velocity}};
}
