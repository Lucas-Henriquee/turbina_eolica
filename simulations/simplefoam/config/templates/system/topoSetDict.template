FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object topoSetDict;
}
// Seleciona as faces da entrada circular.
actions
(
    {
        name fanFaces;
        type faceSet;
        action new;
        source patchToFace;
        patches (inlet);
    }
    {
        name fanFaces;
        type faceSet;
        action subset;
        source cylinderToFace;
        point1 {{fan_point1}};
        point2 {{fan_point2}};
        radius {{fan_radius}};
    }
);
