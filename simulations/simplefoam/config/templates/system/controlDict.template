FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application simpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
// O contador avança uma unidade por iteração.
endTime {{iteration_limit}};
deltaT 1;
writeControl timeStep;
writeInterval {{iteration_write_interval}};
purgeWrite 0;
writeFormat {{output_write_format}};
writePrecision {{output_write_precision}};
writeCompression {{write_compression}};
timeFormat general;
timePrecision {{output_time_precision}};
runTimeModifiable {{iteration_runtime_modifiable}};
#include "forces"
