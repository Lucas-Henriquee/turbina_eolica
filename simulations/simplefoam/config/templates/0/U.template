FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform {{initial_velocity}};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform {{initial_velocity}};
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform {{initial_velocity}};
        value           uniform {{initial_velocity}};
    }
    sides
    {
        type            slip;
    }
    propeller
    {
        type            noSlip;
    }
}
