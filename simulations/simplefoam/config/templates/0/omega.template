FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform {{turbulence_omega}};

boundaryField
{
    fanInlet
    {
        type fixedValue;
        value uniform {{turbulence_omega}};
    }
    "(inlet|outlet|sides)"
    {
        type inletOutlet;
        inletValue uniform {{turbulence_omega}};
        value uniform {{turbulence_omega}};
    }
    ground
    {
        type omegaWallFunction;
        value uniform {{turbulence_omega}};
    }
    propeller
    {
        type            omegaWallFunction;
        blending        binomial;
        n               2;
        value           uniform {{turbulence_omega}};
    }
}
