FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{initial_pressure}};

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform {{initial_pressure}};
    }
    sides
    {
        type            zeroGradient;
    }
    propeller
    {
        type            zeroGradient;
    }
}
