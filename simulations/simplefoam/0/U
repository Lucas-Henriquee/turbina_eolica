FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    fanInlet
    {
        type fixedValue;
        value uniform (0 6.86 0);
    }
    "(inlet|outlet|sides)"
    {
        type pressureInletOutletVelocity;
        value uniform (0 0 0);
    }
    ground
    {
        type noSlip;
    }
    // O MRF aplica a velocidade do rotor.
    propeller
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}
