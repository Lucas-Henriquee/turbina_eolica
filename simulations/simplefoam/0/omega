FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 15;

boundaryField
{
    fanInlet
    {
        type fixedValue;
        value uniform 15;
    }
    "(inlet|outlet|sides)"
    {
        type inletOutlet;
        inletValue uniform 15;
        value uniform 15;
    }
    ground
    {
        type omegaWallFunction;
        value uniform 15;
    }
    propeller
    {
        type            omegaWallFunction;
        blending        binomial;
        n               2;
        value           uniform 15;
    }
}
