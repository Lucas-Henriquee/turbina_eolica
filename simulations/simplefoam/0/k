FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.02;

boundaryField
{
    fanInlet
    {
        type fixedValue;
        value uniform 0.02;
    }
    "(inlet|outlet|sides)"
    {
        type inletOutlet;
        inletValue uniform 0.02;
        value uniform 0.02;
    }
    ground
    {
        type kqRWallFunction;
        value uniform 0.02;
    }
    propeller
    {
        type            kqRWallFunction;
        value           uniform 0.02;
    }
}
