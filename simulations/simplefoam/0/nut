{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(fanInlet|inlet|outlet|sides)"
    {
        type calculated;
        value uniform 0;
    }
    ground
    {
        type nutkWallFunction;
        value uniform 0;
    }
    propeller
    {
        type            nutkWallFunction;
        blending        stepwise;
        value           uniform 0;
    }
}
