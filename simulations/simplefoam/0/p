FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    fanInlet
    {
        type zeroGradient;
    }
    "(inlet|outlet|sides)"
    {
        type totalPressure;
        p0 uniform 0;
        value uniform 0;
    }
    ground
    {
        type fixedFluxPressure;
        value uniform 0;
    }
    propeller
    {
        type            zeroGradient;
    }
}
